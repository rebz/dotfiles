#!/bin/bash
# https://github.com/larrybotha/designer-dotfiles
# https://github.com/mathiasbynens/dotfiles/blob/master/.macos

# Hide "last login" line when starting a new terminal session
touch $HOME/.hushlogin

# macOS defaults (Finder, Dock, screenshots, power) live in osx/set-defaults.sh



#################################################################
### XCode Command Line Tools
#################################################################

echo 'install xcode command line tools'
echo '-----------------'
xcode-select --install
echo 'If a dialog appeared, finish installing Command Line Tools before continuing.'
read -p 'Press enter to continue...'



#################################################################
### GIT
#################################################################

# symlink git config + global gitignore (gitconfig sets excludesfile)
ln -s $HOME/.dotfiles/shell/.gitignore_global $HOME/.gitignore_global
ln -s $HOME/.dotfiles/shell/.gitconfig $HOME/.gitconfig


#################################################################
### ZSH
#################################################################

# install oh-my-zsh (RUNZSH/CHSH keep the installer from hijacking this script)
echo 'install oh-my-zsh'
echo '-----------------'
rm -rf $HOME/.oh-my-zsh
RUNZSH=no CHSH=no sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
git clone https://github.com/zsh-users/zsh-autosuggestions $HOME/.oh-my-zsh/custom/plugins/zsh-autosuggestions

# symlink zsh prefs
rm -f $HOME/.zshrc
ln -s $HOME/.dotfiles/shell/.zshrc $HOME/.zshrc



#################################################################
### Homebrew
#################################################################

echo 'install homebrew'
echo '----------------'
/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

# make brew usable in this shell (Apple Silicon)
eval "$(/opt/homebrew/bin/brew shellenv)"

echo 'install wget'
echo '----------------'
brew install wget



#################################################################
### Node
#################################################################

echo 'install NVM + Node LTS'
echo '---------------'
curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
nvm install --lts
git clone https://github.com/lukechilds/zsh-nvm ~/.oh-my-zsh/custom/plugins/zsh-nvm



#################################################################
### Other
#################################################################

echo 'install iterm2'
brew install --cask iterm2

echo 'install ngrok'
brew install ngrok/ngrok/ngrok

echo 'install sourcetree'
brew install --cask sourcetree

echo 'install sketch'
brew install --cask sketch

echo 'install vscode'
brew install --cask visual-studio-code

echo 'install yarn'
brew install yarn

echo 'install fira code font for terminal'
brew install --cask font-fira-code

echo 'install flux'
brew install --cask flux

echo 'install spotify'
brew install --cask spotify


#################################################################
### Mobile Access (used by `mobile` function in .functions)
#################################################################

echo 'install tmux'
brew install tmux

echo 'install tailscale'
brew install --cask tailscale


#################################################################
### Agentic Tools
#################################################################

echo 'install codexbar: monitor agentic usage (M-series only)'
brew install --cask steipete/tap/codexbar



#################################################################
### Done
#################################################################

echo '++++++++++++++++++++++++++++++'
echo '++++++++++++++++++++++++++++++'
echo 'all done'

echo '++++++++++++++++++++++++++++++'
echo 'Some optional tidbits'

echo '1. set some sensible os x defaults by running: $HOME/.dotfiles/osx/set-defaults.sh'
echo '2. make a .dotfiles-custom/shell/.(exports,aliases,functions,zshrc) for your personal commands'

echo '++++++++++++++++++++++++++++++'
echo 'Please report issues!'
